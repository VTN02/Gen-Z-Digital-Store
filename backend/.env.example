# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=genz_digital_store

# Complete Database Connection URL String
DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/genz_digital_store

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=8h

# Admin Access Key (keep secret, never commit real value)
ADMIN_ACCESS_KEY=YOUR_ADMIN_KEY_HERE

# CORS
CORS_ORIGIN=http://localhost:5173
